{
  "id": "perplexity",
  "name": "Perplexity",
  "url": "https://www.perplexity.ai",
  "partition": "persist:perplexity",
  "selectors": {
    "input": "#ask-input",
    "send": "button[aria-label=\"제출\"], button[aria-label=\"Submit\"]",
